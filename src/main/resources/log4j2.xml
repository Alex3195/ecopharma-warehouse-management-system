<?xml version="1.0" encoding="UTF-8" ?>
<Configuration status="WARN" name="Project name">
    <Properties>
        <Property name="log-path">logs</Property>
        <Property name="logfile-name">wms</Property>
        <Property name="LOG_EXCEPTION_CONVERSION_WORD">%xwEx</Property>
        <Property name="LOG_LEVEL_PATTERN">%5p</Property>
    </Properties>

    <Appenders>
        <!-- Console Appender -->
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%clr{%d{yyyy-MM-dd HH:mm:ss.SSS}}{faint} %clr{${LOG_LEVEL_PATTERN}} %clr{${sys:PID}}{magenta} %clr{---}{faint} %clr{[%15.15t]}{faint} %clr{%-40.40c{1.}}{cyan} %clr{:}{faint} %m%n${sys:LOG_EXCEPTION_CONVERSION_WORD}"/>
        </Console>

        <!-- RollingFile Appender -->
        <RollingFile name="RollingFile" filePattern="${log-path}/${logfile-name}-%d{yyyy-MM-dd}.log">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} ${LOG_LEVEL_PATTERN} ${sys:PID} --- [%15.15t] %c : %m%n${sys:LOG_EXCEPTION_CONVERSION_WORD}" />
            <Policies>
                <TimeBasedTriggeringPolicy />
            </Policies>
            <DirectWriteRolloverStrategy/>
        </RollingFile>

        <!-- Socket Appender for Logstash -->
        <Socket name="Logstash" host="192.168.7.12" port="5000" protocol="tcp">
            <JsonLayout compact="true" eventEol="true" properties="true" />
        </Socket>
    </Appenders>

    <Loggers>
        <!-- Root Logger -->
        <Root level="ERROR">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="Logstash"/>
        </Root>

        <!-- Logger for org.springframework.boot package -->
        <Logger name="org.springframework" level="INFO" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="RollingFile" level="DEBUG"/>
            <AppenderRef ref="Logstash"/>
        </Logger>

        <!-- Logger for org.apache.catalina package -->
        <Logger name="org.apache.catalina" level="INFO" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="RollingFile" level="DEBUG"/>
            <AppenderRef ref="Logstash"/>
        </Logger>

        <!-- Logger for org.hibernate package -->
        <Logger name="org.hibernate" level="INFO" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="RollingFile" level="DEBUG"/>
            <AppenderRef ref="Logstash"/>
        </Logger>

        <!-- Logger for com.zaxxer.hikari package -->
        <Logger name="com.zaxxer.hikari" level="INFO" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="RollingFile" level="DEBUG"/>
            <AppenderRef ref="Logstash"/>
        </Logger>

        <!-- Logger for uz.duol.ecopharmwarehouse package -->
        <Logger name="uz.duol.ecopharmwarehouse" level="DEBUG" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="RollingFile"/>
            <AppenderRef ref="Logstash"/>
        </Logger>
    </Loggers>
</Configuration>