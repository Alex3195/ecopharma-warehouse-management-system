<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN" name="EcoPharmWMS">
    <Properties>
        <Property name="LOG_PATH">logs</Property>
        <Property name="LOG_FILE_NAME">wms</Property>
        <Property name="LOG_EXCEPTION_CONVERSION_WORD">%xwEx</Property>
        <Property name="LOG_LEVEL_PATTERN">%5p</Property>

        <!-- Logstash props can be overridden via system/env properties or Spring Boot config -->
        <Property name="LOGSTASH_HOST">${sys:logstash.host:-}</Property>
        <Property name="LOGSTASH_PORT">${sys:logstash.port:-0}</Property>
    </Properties>

    <Appenders>
        <!-- Console -->
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout
                    pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} ${LOG_LEVEL_PATTERN} --- [%15.15t] %-40.40c{1.} : %m%n${LOG_EXCEPTION_CONVERSION_WORD}" />
        </Console>

        <!-- Rolling File -->
        <RollingFile name="RollingFile"
                     fileName="${LOG_PATH}/${LOG_FILE_NAME}.log"
                     filePattern="${LOG_PATH}/${LOG_FILE_NAME}-%d{yyyy-MM-dd}.log">
            <PatternLayout
                    pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} ${LOG_LEVEL_PATTERN} --- [%15.15t] %-40.40c{1.} : %m%n${LOG_EXCEPTION_CONVERSION_WORD}" />
            <Policies>
                <TimeBasedTriggeringPolicy />
            </Policies>
        </RollingFile>

        <!-- Logstash Socket Appender (safe fallback if host/port are not set) -->
        <Socket name="Logstash"
                host="${LOGSTASH_HOST}"
                port="${LOGSTASH_PORT}"
                protocol="tcp"
                ignoreExceptions="true">
            <JsonLayout compact="true" eventEol="true" properties="true" />
        </Socket>
    </Appenders>

    <Loggers>
        <!-- Root Logger -->
        <Root level="INFO">
            <AppenderRef ref="Console" />
            <AppenderRef ref="RollingFile" />
            <AppenderRef ref="Logstash" />
        </Root>

        <!-- App-specific packages -->
        <Logger name="uz.duol.ecopharmwarehouse" level="DEBUG" additivity="false">
            <AppenderRef ref="Console" />
            <AppenderRef ref="RollingFile" />
            <AppenderRef ref="Logstash" />
        </Logger>
    </Loggers>
</Configuration>
